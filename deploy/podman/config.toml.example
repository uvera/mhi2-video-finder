# Copy to config.toml next to compose.yaml:
#   cp config.toml.example config.toml
#
# Paths below must match the volume mounts in compose.yaml (inside the container).

raw_cache_dir = "/root/.cache/mhi2-video-finder/raw"
output_dir = "/root/Videos/mhi2-video-finder"

# Optional: tune encode defaults (see main README)
# max_width = 720
# max_height = 576
# video_encoder = "libx264"
