# Copy to .env (same directory as compose.yaml):
#   cp .env.example .env
#
# Use the same value in the desktop GUI (Settings -> Bearer token).
# Loaded through compose env_file to avoid token interpolation issues.

DAEMON_BEARER_TOKEN=change-me-to-a-long-random-secret

# Optional: host port published to the container's 8765
# MHI2_VF_PORT=8765

# Optional: NDJSON debug log file inside the container (compose sets a bind mount).
# Leave unset to use compose.yaml defaults; do not set to an empty string.
# MHI2_VF_DEBUG_LOG_PATH=/var/lib/mhi2-video-finder/debug/debug-runtime.log

# Optional: Telegram bot (long polling inside the daemon; no public URL needed).
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
# TELEGRAM_ENABLED=1
# TELEGRAM_POLL_TIMEOUT=50

# Optional: Groq API for Library tab metadata inference (desktop GUI / ~/.config config.toml).
# GROQ_API_KEY=gsk_...
