# Copy to .env (same directory as compose.yaml):
#   cp .env.example .env
#
# Use the same value in the desktop GUI (Settings -> Bearer token).
# Loaded through compose env_file to avoid token interpolation issues.

DAEMON_BEARER_TOKEN=change-me-to-a-long-random-secret

# Optional: host port published to the container's 8765
# MHI2_VF_PORT=8765
