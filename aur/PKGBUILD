# Set url= and source= to your GitHub repo. Run scripts/release-github-aur.sh from upstream
# to refresh sha256sums and .SRCINFO from the tag tarball. The tag archive excludes aur/
# (.gitattributes export-ignore). Copy PKGBUILD + .SRCINFO into your AUR clone and push.

pkgname=mhi2-video-finder
pkgver=0.3.0
pkgrel=1
pkgdesc="YouTube music-video search, download (yt-dlp), and MHI2-oriented MP4 transcode"
arch=('any')
url='https://github.com/uvera/mhi2-video-finder'
license=('MIT')
depends=('python' 'ffmpeg' 'python-pyqt6' 'python-typer' 'yt-dlp')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
install=mhi2-video-finder.install
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/uvera/mhi2-video-finder/archive/refs/tags/v0.3.0.tar.gz")
sha256sums=('a8b0ffbc1b8fad8ad255c879899a45d3a6e6b09f21249a6d0210d794215cd82b')

build() {
  cd "${pkgname}-${pkgver}"
  /usr/bin/python -m build --wheel --no-isolation
}

package() {
  cd "${pkgname}-${pkgver}"
  /usr/bin/python -m installer --destdir="$pkgdir" --prefix=/usr dist/*.whl
}
